# Frontend: public browser URL for the FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend: comma-separated browser origins allowed to call the API.
VICE_PLANNER_CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173,https://omars64-goal-planner.omarsolanki35.chatgpt.site

# Backend: optional SQLite location. Relative paths are resolved by the process.
VICE_PLANNER_DB_PATH=backend/data/vice_planner.db

# Production: managed Postgres connection injected by Vercel's Neon integration.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
