# Frontend: public browser URL for the FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend: comma-separated browser origins allowed to call the API.
VICE_PLANNER_CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173,https://omars64-goal-planner.omarsolanki35.chatgpt.site

# Optional production preview-domain pattern.
GOAL_PLANNER_CORS_ORIGIN_REGEX=https://goal-planner(?:-[a-z0-9-]+)*\.vercel\.app

# Backend: optional SQLite location. Relative paths are resolved by the process.
VICE_PLANNER_DB_PATH=backend/data/vice_planner.db

# Production: managed Postgres connection injected by Vercel's Neon integration.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required backend bootstrap account. Never commit a real production password.
GOAL_PLANNER_ADMIN_EMAIL=admin@example.com
GOAL_PLANNER_ADMIN_USERNAME=Admin
GOAL_PLANNER_ADMIN_PASSWORD=replace-with-a-long-password

# Transactional email provider. "auto" uses Brevo when BREVO_API_KEY is set,
# otherwise it keeps SMTP available for local development and rollback.
EMAIL_PROVIDER=auto
BREVO_API_KEY=replace-with-a-brevo-api-key
BREVO_FROM_EMAIL=sender@example.com
BREVO_FROM_NAME=Goal Planner

# SMTP fallback used when EMAIL_PROVIDER=smtp or no Brevo key is configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=Goal Planner
