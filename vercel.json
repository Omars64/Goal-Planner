{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,.next/**,public/**,app/**,components/**,dist/**,build/**,vendor/**,backend/.venv/**,backend/tests/**,backend/data/**,tests/**,.git/**}"
    }
  }
}
